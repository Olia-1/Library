@model PrivateLibrary.ViewModels.PublicProfileViewModel
@{
    // Public profile identity is the account nickname, never the reader's legal name.
    var displayName = string.IsNullOrWhiteSpace(Model.User.UserName) ? "Reader" : Model.User.UserName;
    ViewData["Title"] = $"{displayName}'s Profile";
}
<section class="public-profile-page">
    <header class="public-profile-hero">
        <div class="public-profile-avatar" aria-label="@displayName">@displayName</div>
        <div class="public-profile-intro">
            <span class="account-eyebrow">PRIVATE LIBRARY READER</span>
            <h1>@displayName</h1>
            <p>Books, ratings and reviews shared by this reader.</p>
        </div>
    </header>

    @if (Model.FavoritesArePublic)
    {
        <section class="public-profile-section">
            <div class="public-profile-section-heading"><div><span class="account-eyebrow">PERSONAL COLLECTION</span><h2>Favorite Books</h2></div><span class="public-profile-count">@Model.Favorites.Count books</span></div>
            @if (Model.Favorites.Count == 0)
            {
                <div class="public-profile-empty">This reader has not added any favorite books yet.</div>
            }
            else
            {
                <div class="public-profile-book-grid">
                    @foreach (var favorite in Model.Favorites)
                    {
                        var book = favorite.Book;
                        var authors = book.BookAuthors.Select(a => $"{a.Author?.FirstName} {a.Author?.LastName}".Trim()).Where(a => !string.IsNullOrWhiteSpace(a));
                        <article class="public-profile-book-card">
                            <a class="public-profile-book-cover" asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl)) { <img src="@book.CoverImageUrl" alt="Cover of @book.Title" loading="lazy" /> }
                                else { <span>✧</span> }
                            </a>
                            <div><h3><a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">@book.Title</a></h3><p>@(authors.Any() ? string.Join(", ", authors) : "Author not specified")</p></div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @if (User.Identity?.IsAuthenticated != true)
    {
        <section class="public-profile-section public-profile-locked"><h2>Reader opinions</h2><p>Sign in to view this reader's published ratings and reviews.</p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="details-reserve-button">Sign in</a></section>
    }
    else
    {
    <section class="public-profile-section">
        <div class="public-profile-section-heading"><div><span class="account-eyebrow">READER'S OPINIONS</span><h2>Published Reviews</h2></div><span class="public-profile-count">@Model.Reviews.Count</span></div>
        @if (Model.Reviews.Count == 0)
        {
            <div class="public-profile-empty">There are no published reviews to display.</div>
        }
        else
        {
            <div class="public-profile-opinion-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="public-profile-opinion"><div class="public-profile-opinion-heading"><h3><a asp-controller="Books" asp-action="Details" asp-route-id="@review.BookId">@review.Book?.Title</a></h3><time>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</time></div><p>@review.Text</p></article>
                }
            </div>
        }
    </section>

    <section class="public-profile-section">
        <div class="public-profile-section-heading"><div><span class="account-eyebrow">BOOK RATINGS</span><h2>Published Ratings</h2></div><span class="public-profile-count">@Model.Ratings.Count</span></div>
        @if (Model.Ratings.Count == 0)
        {
            <div class="public-profile-empty">There are no published ratings to display.</div>
        }
        else
        {
            <div class="public-profile-rating-list">
                @foreach (var rating in Model.Ratings)
                {
                    <article class="public-profile-rating"><a asp-controller="Books" asp-action="Details" asp-route-id="@rating.BookId">@rating.Book?.Title</a><span>@rating.Value/5 <img src="~/images/laurel-small.png" asp-append-version="true" alt="" /></span>@if (!string.IsNullOrWhiteSpace(rating.Text)) { <p>@rating.Text</p> }</article>
                }
            </div>
        }
    </section>
    }
</section>
