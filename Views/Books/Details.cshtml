@model PrivateLibrary.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.DisplayTitle;
    var book = Model.Book;
    var authors = book.BookAuthors.Select(x => x.Author?.DisplayFullName ?? string.Empty)
        .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
    var availableCopies = book.Copies.Count(c => string.Equals(c.Status, "Available", StringComparison.OrdinalIgnoreCase));
}
<section class="book-details-page">
    <a asp-controller="Books" asp-action="Index" class="details-back-link">← Back to catalog</a>
<div class="book-details-card">
        <div class="details-cover-column">
            <div class="details-cover-shell">
                <div class="details-cover">
                    @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl)) { <img src="@book.CoverImageUrl" alt="Cover of @book.DisplayTitle" /> }
                    else { <div class="details-cover-placeholder"><span class="details-cover-mark">✦</span><span class="details-cover-title">@book.DisplayTitle</span><span class="details-cover-author">@(authors.Count > 0 ? string.Join(", ", authors) : "Private Library Collection")</span></div> }
                </div>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Reader"))
                {
                    <form class="details-favorite-form" data-favorite-form>
                        @Html.AntiForgeryToken()
                        <button type="button" class="favorite-toggle-button favorite-heart-button details-cover-favorite @(ViewBag.IsFavorite == true ? "is-favorite" : "")"
                                data-favorite-toggle data-url="@Url.Action("Toggle", "Favorites")" data-book-id="@book.BookId"
                                aria-pressed="@(ViewBag.IsFavorite == true ? "true" : "false")"
                                aria-label="@(ViewBag.IsFavorite == true ? "Remove from favorites" : "Add to favorites")"
                                title="@(ViewBag.IsFavorite == true ? "Remove from favorites" : "Add to favorites")">
                            <svg class="favorite-heart-icon" viewBox="0 0 32 30" aria-hidden="true">
                                <path class="heart-outline" d="M16 27S2 18.5 2 9.8C2 2.8 11.2.4 16 7.1 20.8.4 30 2.8 30 9.8 30 18.5 16 27 16 27Z" />
                                <path class="heart-crack" d="M16 7.1 13.4 13l4.2 2.1-3.2 4.1 2.1 7.8" />
                            </svg>
                        </button>
                    </form>
                }
            </div>
            <div class="details-stock @(availableCopies > 0 ? "stock-available" : "stock-unavailable")"><span class="stock-indicator"></span><span><strong>@(availableCopies > 0 ? "Available to borrow" : "Currently unavailable")</strong><small>@availableCopies @(availableCopies == 1 ? "copy" : "copies") available</small></span></div>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Reader"))
            {
                <form asp-controller="Reservations" asp-action="Create" method="post" class="details-reserve-form"><input type="hidden" name="bookId" value="@book.BookId" /><button type="submit" class="details-reserve-button">Reserve this book <span>→</span></button></form>
                <p class="details-reserve-note">You can place a reservation even when all copies are currently borrowed, subject to library rules.</p>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="details-reserve-button">Sign in to reserve <span>→</span></a>
                <p class="details-reserve-note">Sign in with your reader account to reserve this title.</p>
            }
        </div>
        <div class="details-content">
            <div class="details-kicker">THE PRIVATE LIBRARY COLLECTION</div>
            @if (book.Genre is not null) { <span class="details-genre">@book.Genre.DisplayName</span> }
            <h1>@book.DisplayTitle</h1>
            <p class="details-author">by @(authors.Count > 0 ? string.Join(", ", authors) : "Unknown author")</p>
            <div class="details-rating-row">
                @if (Model.CanViewCommunityContent && Model.ApprovedRatings.Count > 0)
                {
                    <span class="details-laurel-inline" aria-label="Reader ratings"><img src="~/images/laurel-small.png" asp-append-version="true" alt="" /></span><strong>@Model.AverageRating.ToString("0.0") / 5</strong><span class="details-review-count">(@Model.ApprovedRatings.Count ratings)</span>
                }
                else { <span class="details-no-rating">@(Model.CanViewCommunityContent ? "No approved ratings yet" : "Sign in to view reader ratings")</span> }
            </div>
            <div class="details-divider"></div>
            <h2>About this book</h2>
            <p class="details-description">@(string.IsNullOrWhiteSpace(book.DisplayDescription) ? "A description for this title has not been added yet." : book.DisplayDescription)</p>
            <h2 class="details-info-heading">Book information</h2>
            <dl class="details-meta-grid">
                <div><dt>Publication year</dt><dd>@(book.PublicationYear?.ToString() ?? "Not specified")</dd></div>
                <div><dt>Publisher</dt><dd>@(book.Publisher ?? "Not specified")</dd></div>
                <div><dt>Language</dt><dd>@(book.Language ?? "Not specified")</dd></div>
                <div><dt>ISBN</dt><dd>@(book.ISBN ?? "Not specified")</dd></div>
                <div><dt>Genre</dt><dd>@(book.Genre?.DisplayName ?? "Not specified")</dd></div>
                <div><dt>Library copies</dt><dd>@book.Copies.Count</dd></div>
            </dl>
        </div>
    </div>

    @if (!Model.CanViewCommunityContent)
    {
        <section class="details-community-locked"><h2>Ratings &amp; Reviews</h2><p>Sign in to view readers' ratings and reviews, and to share your own opinion.</p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="details-reserve-button">Sign in</a></section>
    }
    else
    {
        <section class="details-community-grid">
            <div class="details-reviews-section" id="ratings">
                <div class="details-section-heading"><div><span class="details-kicker">YOUR SCORE</span><h2>Ratings</h2></div><span class="details-review-total">@Model.ApprovedRatings.Count approved</span></div>
                @if (Model.ApprovedRatings.Count == 0) { <p class="details-no-rating">No approved ratings yet.</p> }
                else
                {
                    <div class="details-rating-summary"><strong>@Model.AverageRating.ToString("0.0") / 5</strong><span>Average reader rating</span></div>
                    <div class="details-community-list details-rating-list">
                        @foreach (var rating in Model.ApprovedRatings.OrderByDescending(x => x.CreatedAt).Take(3))
                        {
                            <article class="details-community-item">
                                <div class="details-community-item-top"><a class="community-author-link" asp-controller="Profile" asp-action="Index" asp-route-id="@rating.UserId"><span class="community-author-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.5 20c.5-3.7 3-5.6 6.5-5.6s6 1.9 6.5 5.6"></path></svg></span><strong>@(string.IsNullOrWhiteSpace(rating.User?.UserName) ? "Reader" : rating.User.UserName)</strong></a><span>@rating.Value/5 <img class="details-laurel-mini" src="~/images/laurel-small.png" asp-append-version="true" alt="" /></span></div>
                                @if (!string.IsNullOrWhiteSpace(rating.Text)) { <p>@rating.Text</p> }
                            </article>
                        }
                    </div>
                }
                @if (Model.MyRating is not null) { <p class="details-moderation-note">Your rating: @Model.MyRating.Value/5 · @Model.MyRating.ModerationStatus</p> }
                <details class="details-composer"><summary>@(Model.MyRating is null ? "Leave a rating" : "Edit your rating")</summary>
                    <form asp-action="SaveRating" method="post" class="details-opinion-form details-compact-form" novalidate data-opinion-form="rating">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@book.BookId" />
                        <fieldset class="laurel-rating-picker"><legend>Your rating</legend>
                        @for (var i = 1; i <= 5; i++)
                        {
                            <label class="laurel-rating-option"><input type="radio" name="ratingValue" value="@i" checked="@(Model.MyRating?.Value == i || (Model.MyRating is null && i == 5))" required />
                            <span class="laurel-wreath" aria-hidden="true">
                                @if (i <= 2)
                                {
                                    <img src="~/images/laurel-small.png" asp-append-version="true" alt="" />
                                }
                                else
                                {
                                    <img src="~/images/laurel-large.png" asp-append-version="true" alt="" />
                                }
                            </span><small>@i</small></label>
                        }
                        </fieldset>
                        <label for="ratingText">Optional note</label><textarea id="ratingText" name="text" maxlength="30" rows="2" aria-describedby="ratingTextError" placeholder="A short thought about this book...">@Model.MyRating?.Text</textarea>
                        <span id="ratingTextError" class="details-field-error" role="alert" aria-live="polite"></span>
                        <small class="details-character-count" data-count-for="ratingText">0 / 30</small>
                        <button type="submit" class="details-reserve-button">@(Model.MyRating is null ? "Submit rating" : "Update rating")</button>
                    </form>
                </details>
                @if (Model.MyRating is not null)
                {
                    <form asp-action="DeleteRating" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MyRating.RatingId" /><input type="hidden" name="bookId" value="@book.BookId" /><button type="submit" class="details-delete-button">Delete my rating</button></form>
                }
            </div>
            <div class="details-reviews-section" id="reviews">
                <div class="details-section-heading"><div><span class="details-kicker">READERS' OPINIONS</span><h2>Reviews</h2></div><span class="details-review-total">@Model.ApprovedReviews.Count published</span></div>
                @if (Model.ApprovedReviews.Count == 0) { <p class="details-no-rating">There are no published reviews for this book yet.</p> }
                @foreach (var review in Model.ApprovedReviews)
                {
                    <article class="details-review"><div class="review-main"><div class="review-topline"><a class="community-author-link" asp-controller="Profile" asp-action="Index" asp-route-id="@review.UserId"><span class="community-author-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.5 20c.5-3.7 3-5.6 6.5-5.6s6 1.9 6.5 5.6"></path></svg></span><strong>@(string.IsNullOrWhiteSpace(review.User?.UserName) ? "Reader" : review.User.UserName)</strong></a><time>@review.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</time></div><p>@review.Text</p></div></article>
                }
                @if (Model.MyReview is not null) { <p class="details-moderation-note">Your review status: @Model.MyReview.ModerationStatus @if (Model.MyReview.UpdatedAt.HasValue) { <span>· Edited @Model.MyReview.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span> }</p> }
                <details class="details-composer"><summary>@(Model.MyReview is null ? "Write a review" : "Edit your review")</summary>
                    <form asp-action="SaveReview" method="post" class="details-opinion-form details-compact-form" novalidate data-opinion-form="review">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@book.BookId" />
                        <label for="reviewText">Your review</label>
                        <textarea id="reviewText" name="text" rows="3" minlength="10" maxlength="5000" aria-describedby="reviewTextError" placeholder="Share what you thought about this book...">@Model.MyReview?.Text</textarea>
                        <span id="reviewTextError" class="details-field-error" role="alert" aria-live="polite"></span>
                        <small class="details-character-count" data-count-for="reviewText">0 / 5000</small>
                        <button type="submit" class="details-reserve-button">@(Model.MyReview is null ? "Submit review" : "Save changes for moderation")</button>
                    </form>
                </details>
                @if (Model.MyReview is not null)
                {
                    <form asp-action="DeleteReview" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MyReview.ReviewId" /><input type="hidden" name="bookId" value="@book.BookId" /><button type="submit" class="details-delete-button">Delete my review</button></form>
                }
            </div>
        </section>
    }
</section>



@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-opinion-form]').forEach(form => {
                const kind = form.dataset.opinionForm;
                const field = form.querySelector('textarea');
                const error = form.querySelector('.details-field-error');
                const counter = form.querySelector('[data-count-for]');
                if (!field || !error) return;
                const min = kind === 'review' ? 10 : 0;
                const max = kind === 'review' ? 5000 : 30;

                const validate = () => {
                    const value = field.value.trim();
                    let message = '';
                    if (kind === 'review' && value.length < min)
                        message = `A review must contain at least ${min} characters.`;
                    else if (value.length > max)
                        message = `The text cannot exceed ${max} characters.`;

                    error.textContent = message;
                    field.classList.toggle('is-invalid', Boolean(message));
                    if (counter) counter.textContent = `${field.value.length} / ${max}`;
                    return !message;
                };

                field.addEventListener('input', validate);
                form.addEventListener('submit', event => {
                    if (!validate()) {
                        event.preventDefault();
                        field.focus();
                    }
                });
                validate();
            });
        })();
    </script>
}
