@model IEnumerable<PrivateLibrary.Models.Book>

@{
    ViewData["Title"] = "Home";
}
<div class="home-page">
    <section class="hero-panel">
        <div class="hero-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> YOUR PRIVATE READING SPACE</span>
            <h1>More than<br />just books.</h1>
            <p>A private library for those who value knowledge, inspiration and community.</p>
            <a class="btn-primary-warm" asp-controller="Books" asp-action="Index">Go to catalog <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-image" role="img" aria-label="Warm library interior with books and plants"></div>
        <div class="hero-leaf hero-leaf-one"></div>
        <div class="hero-leaf hero-leaf-two"></div>
    </section>

    <section class="feature-grid" aria-label="Library features">
        <a class="feature-card" asp-controller="Books" asp-action="Index">
            <span class="feature-icon feature-icon-brown">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5c3.5-1.8 6.5-1.3 9 1v14c-2.5-2.3-5.5-2.8-9-1zM21 5.5c-3.5-1.8-6.5-1.3-9 1v14c2.5-2.3 5.5-2.8 9-1z"></path></svg>
            </span>
            <strong>Book Catalog</strong>
            <span>Find your next<br />favorite book</span>
        </a>
        <a class="feature-card" href="#events">
            <span class="feature-icon feature-icon-green">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M7 3v4M17 3v4M3 10h18M8 14h3M8 17h3M15 14h1"></path></svg>
            </span>
            <strong>Events</strong>
            <span>Literary meetings<br />and activities</span>
        </a>
        <a class="feature-card" href="#community">
            <span class="feature-icon feature-icon-sand">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M3 20v-1.5A5.5 5.5 0 0 1 8.5 13h1A5.5 5.5 0 0 1 15 18.5V20zM16 5.5a3 3 0 0 1 0 5.8M18 13.5a4.5 4.5 0 0 1 3 4.3V20h-3"></path></svg>
            </span>
            <strong>Community</strong>
            <span>Discussions<br />and reviews</span>
        </a>
        <a class="feature-card" asp-controller="Books" asp-action="Index">
            <span class="feature-icon feature-icon-green">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.6 0L12 6l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.6a5.4 5.4 0 0 0 0-7.6Z"></path></svg>
            </span>
            <strong>Favorites</strong>
            <span>Save interesting<br />books</span>
        </a>
    </section>

    <section class="popular-section">
        <div class="section-heading">
            <div><span class="eyebrow">READY TO BORROW</span><h2>Available Books</h2></div>
            <a asp-controller="Books" asp-action="Index" class="text-link">View all <span>→</span></a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="home-books-empty">
                <h3>No books are currently available</h3>
                <p>Please check the catalog again later.</p>
                <a asp-controller="Books" asp-action="Index" class="text-link">Explore the catalog →</a>
            </div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in Model)
                {
                    var authors = string.Join(", ", book.BookAuthors
                        .Select(x => $"{x.Author?.FirstName} {x.Author?.LastName}".Trim())
                        .Where(x => !string.IsNullOrWhiteSpace(x)));
                    var availableCopies = book.Copies.Count(copy => copy.Status == "Available");
                    <a class="home-book-link" asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" aria-label="View details for @book.Title">
                        <article class="book-card home-book-card">
                            <div class="book-cover">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl" alt="Cover of @book.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="home-book-no-cover" aria-label="No cover available">📖</div>
                                }
                            </div>
                            <div class="book-info">
                                <h3>@book.Title</h3>
                                <p>@(string.IsNullOrWhiteSpace(authors) ? "Unknown author" : authors)</p>
                                <span class="home-availability">@availableCopies @(availableCopies == 1 ? "copy" : "copies") available</span>
                                @if (book.Genre != null)
                                {
                                    <span class="genre-pill">@book.Genre.Name</span>
                                }
                            </div>
                        </article>
                    </a>
                }
            </div>
        }
    </section>

    <section class="promo-grid" id="events">
        <article class="event-promo">
            <div class="promo-copy"><span class="eyebrow">MEET. READ. CONNECT.</span><h2>Upcoming Events</h2><p>Join literary meetings, discussions and our reading club.</p><a class="btn-secondary-warm" asp-controller="Home" asp-action="Privacy">View events <span>→</span></a></div>
        </article>
        <article class="community-promo" id="community">
            <div><span class="eyebrow">YOUR PEOPLE, YOUR STORIES</span><h2>Be Part of<br />Our Community</h2><p>Share your thoughts, leave reviews, and discover new books together.</p><a class="community-link" asp-controller="Account" asp-action="Register">Join the community →</a></div>
        </article>
    </section>
</div>
