@model List<EventListItemViewModel>
@{
    ViewData["Title"] = "My events";
}
<section class="events-page">
    <a class="events-back-link" asp-action="Index">← All events</a>
    <div class="events-toolbar">
        <div><span class="events-eyebrow">YOUR COMMUNITY</span><h1>My Events & Registrations</h1></div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="events-empty">
            <span>✦</span><h3>You don't have any events yet</h3>
            <p>Events you create and events you register for will appear here.</p>
            <a class="event-button" asp-action="Index">Explore events</a>
        </div>
    }
    else
    {
        <div class="events-grid">
            @foreach (var item in Model)
            {
                <article class="event-card">
                    <div class="event-date-tile"><span>@item.EventDate.ToString("MMM")</span><strong>@item.EventDate.ToString("dd")</strong><small>@item.EventDate.ToString("yyyy")</small></div>
                    <div class="event-card-body">
                        <div class="event-card-meta"><span>◷ @item.EventDate.ToString("HH:mm")</span><span>@(item.EventDate < DateTime.Now ? "Past event" : "Upcoming")</span></div>
                        <h3>@item.Title</h3>
                        @if (item.IsOrganizer)
                        {
                            <span class="event-registered-label">Created by you</span>
                            @if (item.ModerationStatus != "Approved")
                            {
                                <span class="event-availability">Moderation: @item.ModerationStatus</span>
                            }
                        }
                        @if (item.IsRegistered)
                        {
                            <span class="event-registered-label">You are participating</span>
                        }
                        <p>@item.Location</p>
                        <a class="event-details-link" asp-action="Details" asp-route-id="@item.EventId">View details <span>→</span></a>
                    </div>
                </article>
            }
        </div>
    }
</section>
