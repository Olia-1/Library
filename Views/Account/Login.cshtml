@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-scene">
    <div class="auth-botanical auth-botanical-top"></div>
    <div class="auth-botanical auth-botanical-bottom"></div>
    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <span class="auth-brand-name">Library</span>
        <span class="auth-brand-tagline">Private Library</span>
    </a>
    <section class="auth-card">
        <h1>Login</h1>
        <p class="auth-intro">Welcome back!<br />Log in to your account to access the catalog, make reservations, and explore other library features.</p>
        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label class="input-wrap">
                <span class="field-icon" aria-hidden="true">✉</span>
                <input asp-for="UserName" autocomplete="username" placeholder="Email or username" aria-label="Email or username" />
            </label>
            <span asp-validation-for="UserName" class="field-validation"></span>
            <label class="input-wrap">
                <span class="field-icon" aria-hidden="true">♙</span>
                <input asp-for="Password" id="loginPassword" type="password" autocomplete="current-password" placeholder="Password" aria-label="Password" />
                <button class="password-toggle" type="button" data-toggle-password="loginPassword" aria-label="Show password">◉</button>
            </label>
            <span asp-validation-for="Password" class="field-validation"></span>
            <div class="auth-options">
                <label class="remember-option"><input asp-for="RememberMe" /> <span>Remember me</span></label>
                <a asp-controller="Account" asp-action="Login" class="subtle-link" title="Contact the library administrator to reset your password">Forgot password?</a>
            </div>
            <button type="submit" class="auth-submit">Log In</button>
        </form>
        <p class="auth-switch">Don't have an account? <a asp-action="Register">Sign up</a></p>
    </section>
    <div class="auth-book-decoration" aria-hidden="true"><span></span><span></span><span></span></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
