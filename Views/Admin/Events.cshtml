@model List<PrivateLibrary.Models.Event>
@{
    ViewData["Title"] = "Event Moderation";
}
<div class="admin-shell">
    <partial name="_AdminSidebar" />
    <section class="admin-content">
        <div class="admin-page-heading">
            <div>
                <span class="admin-eyebrow">CONTENT MODERATION</span>
                <h1>Events</h1>
                <p>Review, publish, hide or remove community events.</p>
            </div>
            <a class="admin-primary-button" asp-controller="Events" asp-action="Create">＋ Create Event</a>
        </div>

        <section class="admin-panel">
            <div class="admin-panel-heading">
                <h2>Events (@Model.Count)</h2>
                <span class="admin-muted">@Model.Count(e => e.ModerationStatus == "Pending") awaiting review</span>
            </div>
            <form method="get" asp-action="Events" class="admin-filter-form">
                <input type="search" name="search" value="@ViewBag.Search" placeholder="Search event or organizer" aria-label="Search event or organizer" />
                <select name="status" aria-label="Filter by moderation status"><option value="">All statuses</option><option value="Pending" selected="@(ViewBag.Status as string == "Pending")">Pending</option><option value="Approved" selected="@(ViewBag.Status as string == "Approved")">Approved</option><option value="Rejected" selected="@(ViewBag.Status as string == "Rejected")">Rejected</option></select>
                <select name="location" aria-label="Filter by location"><option value="">All locations</option><option value="In Library" selected="@(ViewBag.Location as string == "In Library")">In Library</option><option value="Online" selected="@(ViewBag.Location as string == "Online")">Online</option></select>
                <input type="date" name="from" value="@ViewBag.From" min="0001-01-01" max="9999-12-31" aria-label="Event date from" /><input type="date" name="to" value="@ViewBag.To" min="0001-01-01" max="9999-12-31" aria-label="Event date to" /><span class="field-validation admin-date-range-warning" role="alert">@ViewBag.DateRangeError</span>
                <button type="submit" class="admin-secondary-button">Apply filters</button><a class="admin-secondary-button" asp-action="Events">Reset</a>
            </form>
    <script>
        (() => {
            const form = document.querySelector(".admin-filter-form");
            const from = form?.querySelector('input[name="from"]');
            const to = form?.querySelector('input[name="to"]');
            const warning = form?.querySelector(".admin-date-range-warning");
            if (!form || !from || !to || !warning) return;
            const validateRange = () => {
                const invalid = !!(from.value && to.value && from.value > to.value);
                const message = invalid ? "The 'from' date cannot be later than the 'to' date." : "";
                warning.textContent = message;
                from.setCustomValidity(message);
                to.setCustomValidity(message);
                return !invalid;
            };
            from.addEventListener("input", validateRange);
            to.addEventListener("input", validateRange);
            form.addEventListener("submit", event => {
                if (!validateRange()) { event.preventDefault(); to.reportValidity(); }
            });
            validateRange();
        })();
    </script>

            @if (Model.Count == 0)
            {
                <div class="admin-empty">No events have been submitted.</div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <article class="admin-review-row">
                        <div class="admin-moderation-entry">
                            <strong>@item.Title</strong>
                            <span>Organized by @(item.Creator?.UserName ?? "Library member") · @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            <p>@(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)</p>
                            <div class="admin-event-meta">
                                <span>Event date: @item.EventDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                <span>Location: @(string.IsNullOrWhiteSpace(item.Location) ? "Not specified" : item.Location)</span>
                                <span>Duration: @item.DurationLabel</span>
                                <span>Participants limit: @item.MaxParticipants</span>
                                <span class="admin-status">Moderation: @(item.ModerationStatus ?? "Approved")</span>
                                @if (item.ModerationStatus == "Approved" || item.ModerationStatus == null)
                                {
                                    <span class="admin-status">Visibility: @(item.IsVisible ? "Visible" : "Hidden")</span>
                                }
                            </div>
                        </div>
                        <div class="admin-decision-actions admin-event-actions">
                            @if (item.ModerationStatus == "Pending")
                            {
                                <form asp-action="EventDecision" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.EventId" />
                                    <input type="hidden" name="decision" value="Approved" />
                                    <button class="admin-approve" type="submit">Approve</button>
                                </form>
                                <form asp-action="EventDecision" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.EventId" />
                                    <input type="hidden" name="decision" value="Rejected" />
                                    <button class="admin-reject" type="submit">Reject</button>
                                </form>
                            }
                            @if (item.ModerationStatus == "Approved" || item.ModerationStatus == null)
                            {
                                <form asp-action="ToggleEventVisibility" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.EventId" />
                                    <button class="admin-secondary-button" type="submit">@(item.IsVisible ? "Hide event" : "Show event")</button>
                                </form>
                            }
                            <form asp-action="DeleteEvent" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.EventId" />
                                <button class="admin-reject" type="submit"
                                        data-site-confirm="This will permanently delete the event and all its registrations. This action cannot be undone."
                                        data-site-confirm-title="Delete event?"
                                        data-site-confirm-cancel="Keep event"
                                        data-site-confirm-accept="Delete event">Delete</button>
                            </form>
                        </div>
                    </article>
                }
            }
        </section>
    </section>
</div>
