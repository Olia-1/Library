@model List<PrivateLibrary.Models.Review>
@{ ViewData["Title"] = "Review Moderation"; }
<div class="admin-shell"><partial name="_AdminSidebar" /><section class="admin-content">
    <div class="admin-page-heading"><div><span class="admin-eyebrow">CONTENT MODERATION</span><h1>Reviews</h1><p>Moderate written reviews separately from numeric ratings.</p></div></div>
<section class="admin-panel"><div class="admin-panel-heading"><h2>All reviews (@Model.Count)</h2></div>
    @if (Model.Count == 0) { <div class="admin-empty">No reviews have been submitted.</div> }
    @foreach (var review in Model) {
        <article class="admin-review-row"><div><strong>@review.Book.Title</strong><span>by @review.User.UserName · @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><p>@review.Text</p><small class="admin-muted">Status: @review.ModerationStatus @if (review.UpdatedAt.HasValue) { <span>· Edited @review.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span> }</small></div>
        @if (review.ModerationStatus == "Pending") { <div class="admin-decision-actions"><form asp-action="ReviewDecision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Approved"/><button class="admin-approve" type="submit">Approve</button></form><form asp-action="ReviewDecision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Rejected"/><button class="admin-reject" type="submit">Reject</button></form></div> }
        </article>
    }
    </section>
</section></div>
