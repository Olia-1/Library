@model List<PrivateLibrary.Models.Review>
@{ ViewData["Title"] = "Review Moderation"; }
<div class="admin-shell"><partial name="_AdminSidebar" /><section class="admin-content">
    <div class="admin-page-heading"><div><span class="admin-eyebrow">CONTENT MODERATION</span><h1>Reviews</h1><p>Moderate written reviews separately from numeric ratings.</p></div></div>
<section class="admin-panel"><div class="admin-panel-heading"><h2>Reviews (@Model.Count)</h2></div>
    <form method="get" asp-action="Reviews" class="admin-filter-form">
        <input type="search" name="search" value="@ViewBag.Search" placeholder="Search book or reader" aria-label="Search book or reader" />
        <select name="status" aria-label="Filter by moderation status"><option value="">All statuses</option><option value="Pending" selected="@(ViewBag.Status as string == "Pending")">Pending</option><option value="Approved" selected="@(ViewBag.Status as string == "Approved")">Approved</option><option value="Rejected" selected="@(ViewBag.Status as string == "Rejected")">Rejected</option></select>
        <input type="date" name="from" value="@ViewBag.From" min="0001-01-01" max="9999-12-31" aria-label="From date" /><input type="date" name="to" value="@ViewBag.To" min="0001-01-01" max="9999-12-31" aria-label="To date" /><span class="field-validation admin-date-range-warning" role="alert">@ViewBag.DateRangeError</span>
        <button type="submit" class="admin-secondary-button">Apply filters</button><a class="admin-secondary-button" asp-action="Reviews">Reset</a>
    </form>
    <script>
        (() => {
            const form = document.querySelector(".admin-filter-form");
            const from = form?.querySelector('input[name="from"]');
            const to = form?.querySelector('input[name="to"]');
            const warning = form?.querySelector(".admin-date-range-warning");
            if (!form || !from || !to || !warning) return;
            const validateRange = () => {
                const invalid = !!(from.value && to.value && from.value > to.value);
                const message = invalid ? "The 'from' date cannot be later than the 'to' date." : "";
                warning.textContent = message;
                from.setCustomValidity(message);
                to.setCustomValidity(message);
                return !invalid;
            };
            from.addEventListener("input", validateRange);
            to.addEventListener("input", validateRange);
            form.addEventListener("submit", event => {
                if (!validateRange()) { event.preventDefault(); to.reportValidity(); }
            });
            validateRange();
        })();
    </script>
    @if (Model.Count == 0) { <div class="admin-empty">No reviews have been submitted.</div> }
    @foreach (var review in Model) {
        <article class="admin-review-row"><div><strong>@review.Book.Title</strong><span>by @review.User.UserName · @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><p>@review.Text</p><small class="admin-muted">Status: @review.ModerationStatus @if (review.UpdatedAt.HasValue) { <span>· Edited @review.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span> }</small></div>
        @if (review.ModerationStatus == "Pending") { <div class="admin-decision-actions"><form asp-action="ReviewDecision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Approved"/><button class="admin-approve" type="submit">Approve</button></form><form asp-action="ReviewDecision" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Rejected"/><button class="admin-reject" type="submit">Reject</button></form></div> }
        </article>
    }
    </section>
</section></div>
