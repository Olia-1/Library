@model List<PrivateLibrary.Models.Review>
@{ ViewData["Title"] = "Reviews & Comments"; }
<div class="admin-shell"><partial name="_AdminSidebar" /><section class="admin-content">
    <div class="admin-page-heading"><div><span class="admin-eyebrow">CONTENT MODERATION</span><h1>Reviews &amp; Comments</h1><p>Moderate reader ratings and written comments.</p></div></div>
    @if (TempData["AdminMessage"] is string message) { <div class="admin-alert">@message</div> }
    <section class="admin-panel"><div class="admin-panel-heading"><h2>All reviews (@Model.Count)</h2></div>
    @if (Model.Count == 0) { <div class="admin-empty">No reviews have been submitted.</div> }
    @foreach (var review in Model) {
        <article class="admin-review-row"><div><strong>@review.Book.Title · <span class="admin-stars">@review.Rating / 5 ★</span></strong><span>by @review.User.UserName · @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><p>@(string.IsNullOrWhiteSpace(review.Comment) ? "No written review." : review.Comment)</p><small class="admin-muted">Status: @review.ModerationStatus</small></div>
        @if (review.ModerationStatus == "Pending") { <div class="admin-decision-actions"><form asp-action="ReviewDecision" method="post"><input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Approved"/><button class="admin-approve" type="submit">Approve</button></form><form asp-action="ReviewDecision" method="post"><input type="hidden" name="id" value="@review.ReviewId"/><input type="hidden" name="decision" value="Rejected"/><button class="admin-reject" type="submit">Reject</button></form></div> }
        </article>
    }
    </section>
</section></div>
