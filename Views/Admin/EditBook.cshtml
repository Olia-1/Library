@model PrivateLibrary.ViewModels.AdminBookViewModel
@{
    ViewData["Title"] = "Edit Book";
}
<div class="admin-shell">
    <partial name="_AdminSidebar" />
    <section class="admin-content">
        <div class="admin-page-heading">
            <div>
                <span class="admin-eyebrow">CATALOG MANAGEMENT</span>
                <h1>Edit book</h1>
                <p>Update the book details. Manage physical copy quantities from the catalog card.</p>
            </div>
        </div>

        <form asp-action="EditBook" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <section class="admin-panel">
                <div class="catalog-filter-grid">
                    <partial name="_BookFormFields" model="Model" />
                </div>
                <div class="catalog-filter-actions">
                    <a asp-action="Books" class="catalog-reset-link">Cancel</a>
                    <button type="submit" class="catalog-apply-button">Save changes</button>
                </div>
            </section>
        </form>
    </section>
</div>
