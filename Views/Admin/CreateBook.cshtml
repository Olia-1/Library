@model PrivateLibrary.ViewModels.AdminBookViewModel
@{
    ViewData["Title"] = "Add Book";
}
<div class="admin-shell">
    <partial name="_AdminSidebar" />
    <section class="admin-content">
        <div class="admin-page-heading">
            <div>
                <span class="admin-eyebrow">CATALOG MANAGEMENT</span>
                <h1>Add a book</h1>
                <p>Enter the book details and the number of physical copies to create.</p>
            </div>
        </div>

        <form asp-action="CreateBook" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <section class="admin-panel">
                <div class="catalog-filter-grid">
                    <partial name="_BookFormFields" model="Model" />
                    <div class="catalog-field">
                        <label asp-for="InitialCopies"></label>
                        <input asp-for="InitialCopies" type="number" min="0" max="1000" />
                        <span asp-validation-for="InitialCopies" class="text-danger"></span>
                    </div>
                </div>
                <div class="catalog-filter-actions">
                    <a asp-action="Books" class="catalog-reset-link">Cancel</a>
                    <button type="submit" class="catalog-apply-button">Save book</button>
                </div>
            </section>
        </form>
    </section>
</div>
