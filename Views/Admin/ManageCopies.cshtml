@model PrivateLibrary.ViewModels.BookCopyManagementViewModel
@{
    ViewData["Title"] = "Manage Copies";
    ViewData["CanDeleteCopies"] = true;
}
<div class="admin-shell">
    <partial name="_AdminSidebar" />
    <section class="admin-content">
        <div class="copy-management">
            <div class="copy-management-header">
                <div>
                    <span class="admin-eyebrow">CATALOG MANAGEMENT</span>
                    <h1>Manage Copies</h1>
                    <p>@Model.BookTitle · @Model.Copies.Count physical copy/copies</p>
                </div>
                <a asp-action="Books" asp-route-status="@(Model.IsArchived ? "archived" : "active")" class="copy-management-back">Back to catalog</a>
            </div>
            <partial name="_BookCopiesList" model="Model" />
        </div>
    </section>
</div>
